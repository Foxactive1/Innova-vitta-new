# InNova Vitta+ — exemplo de configuração
# Copie para .env apenas em desenvolvimento local.
# Em produção configure os valores no provedor de hospedagem.

SECRET_KEY=gere-uma-chave-forte-e-unica
DEBUG=True
SESSION_COOKIE_SECURE=False
WTF_CSRF_SSL_STRICT=False

# Desenvolvimento local:
DATABASE_URL=sqlite:///instance/clinica_vida_plus.db

# Produção (exemplo — nunca versione credenciais reais):
# DATABASE_URL=postgresql://usuario:senha@host/database?sslmode=require

ADMIN_USERNAME=admin

# Recomendado: armazene somente o hash.
# Gere com:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('SUA-SENHA'))"
ADMIN_PASSWORD_HASH=

# Apenas para desenvolvimento/transição. Evite em produção.
ADMIN_PASSWORD=
ADMIN_ROLE=admin
