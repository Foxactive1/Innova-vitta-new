{
  "name": "innova-vitta-new",
  "version": "0.1.0",
  "description": "Frontend assets build for InNova Vitta+ (Flask) — Webpack + npm setup",
  "main": "index.js",
  "scripts": {
    "dev": "webpack serve --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "watch": "webpack --config webpack.config.js --watch",
    "clean": "rimraf static/dist",
    "start": "npm run build"
  },
  "author": "Foxactive1",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.0"
  },
  "devDependencies": {
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "sass": "^1.72.0",
    "sass-loader": "^13.4.2",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.4.2",
    "autoprefixer": "^10.4.14",
    "babel-loader": "^9.1.2",
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "terser-webpack-plugin": "^5.4.5",
    "clean-webpack-plugin": "^4.0.0",
    "rimraf": "^5.0.0"
  },
  "browserslist": [
    "defaults"
  ]
}
